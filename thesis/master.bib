@article{shelton_identification_2024,
	title = {Identification of genetic subtypes in follicular lymphoma},
	volume = {14},
	copyright = {2024 The Author(s)},
	issn = {2044-5385},
	url = {https://www.nature.com/articles/s41408-024-01111-w},
	doi = {10.1038/s41408-024-01111-w},
	abstract = {Follicular lymphoma (FL) exhibits considerable variability in biological features and clinical trajectories across patients. To dissect the diversity of FL, we utilized a Bernoulli mixture model to identify genetic subtypes in 713 pre-treatment tumor tissue samples. Our analysis revealed the existence of five subtypes with unique genetic profiles that correlated with clinicopathological characteristics. The clusters were enriched in specific mutations as follows: CS (CREBBP and STAT6), TT (TNFAIP3 and TP53), GM (GNA13 and MEF2B), Q (quiescent, for low mutation burden), and AR (mutations of mTOR pathway-related genes). The subtype Q was enriched for patients with stage I disease and associated with a lower proliferative history than the other subtypes. The AR subtype was unique in its enrichment for IgM-expressing FL cases and was associated with advanced-stage and more than 4 nodal sites. The existence of subtypes was validated in an independent cohort of 418 samples from the GALLIUM trial. Notably, patients assigned to the TT subtype consistently experienced inferior progression-free survival when treated with immunochemotherapy. Our findings offer insight into core pathways distinctly linked with each FL cluster and are expected to be informative in the era of targeted therapies.},
	language = {en},
	number = {1},
	urldate = {2025-09-05},
	journal = {Blood Cancer Journal},
	author = {Shelton, Victoria and Detroja, Rajesh and Liu, Ting and Isaev, Keren and Silva, Anjali and Passerini, Verena and Bakhtiari, Mehran and Calvente, Lourdes and Hong, Michael and He, Michael Y. and Modi, Saloni and Hershenfeld, Samantha A. and Ludvigsen, Maja and Madsen, Charlotte and Hamilton-Dutoit, Stephen and d’Amore, Francesco Annibale and Brodtkorb, Marianne and Johnson, Nathalie A. and Baetz, Tara and LeBrun, David and Tobin, Josh W. D. and Gandhi, Maher K. and Mungall, Andrew J. and Xu, Wei and Ben-Neriah, Susana and Steidl, Christian and Delabie, Jan and Tremblay-LeMay, Rosemarie and Jegede, Opeyemi and Weigert, Oliver and Kahl, Brad and Evens, Andrew M. and Kridel, Robert},
	month = aug,
	year = {2024},
	note = {Publisher: Nature Publishing Group},
	keywords = {B-cell lymphoma, Cancer genomics, Translational research},
	pages = {128},
	file = {Full Text PDF:/home/hoshi/Zotero/storage/87JSKJBC/Shelton et al. - 2024 - Identification of genetic subtypes in follicular lymphoma.pdf:application/pdf},
}

@article{pasqualucci_genetics_2014,
	title = {Genetics of follicular lymphoma transformation},
	volume = {6},
	issn = {2211-1247},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC4100800/},
	doi = {10.1016/j.celrep.2013.12.027},
	abstract = {Follicular lymphoma (FL) is an indolent disease, but 30-40\% of cases undergo
histologic transformation to an aggressive malignancy, typically represented by diffuse
large B cell lymphoma (DLBCL). The pathogenesis of this process remains largely unknown.
Using whole-exome sequencing and copy-number analysis, here we show that the dominant
clone of FL and transformed FL (tFL) arise by divergent evolution from a common mutated
precursor through the acquisition of distinct genetic events. Mutations in epigenetic
modifiers and anti-apoptotic genes are introduced early in the common precursor, while tFL
is specifically associated with alterations deregulating cell-cycle progression and
DNA-damage responses (CDKN2A/B, MYC, TP53), as well as with aberrant
somatic hypermutation. The genomic profile of tFL shares similarities with that of
germinal center B-cell-type de novo DLBCL, but also displays unique
combinations of altered genes, with diagnostic and therapeutic implications.},
	number = {1},
	urldate = {2025-10-01},
	journal = {Cell reports},
	author = {Pasqualucci, Laura and Khiabanian, Hossein and Fangazio, Marco and Vasishtha, Mansi and Messina, Monica and Holmes, Antony B. and Ouillette, Peter and Trifonov, Vladimir and Rossi, Davide and Tabbò, Fabrizio and Ponzoni, Maurilio and Chadburn, Amy and Murty, Vundavalli V. and Bhagat, Govind and Gaidano, Gianluca and Inghirami, Giorgio and Malek, Sami N. and Rabadan, Raul and Dalla-Favera, Riccardo},
	month = jan,
	year = {2014},
	pmid = {24388756},
	pmcid = {PMC4100800},
	pages = {130--140},
	file = {Accepted Version:/home/hoshi/Zotero/storage/574L84TP/Pasqualucci et al. - 2014 - Genetics of follicular lymphoma transformation.pdf:application/pdf},
}
